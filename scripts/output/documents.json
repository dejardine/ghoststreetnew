    },
    "body": [
      {
        "type": "paragraph",
        "text": "We offer daytime and early evening Click and Collect from 27 Galway Street, Britomart.",
        "spans": [
          {
            "type": "strong",
            "start": 0,
            "end": 86
          }
        ],
        "direction": "ltr"
      },
      {
        "type": "paragraph",
        "text": "Pick-up will be available during the following times;\nSun- Thursday - 5pm till 8.30pm\nFri - Sat, 5pm till 7pm",
        "spans": [],
        "direction": "ltr"
      },
      {
        "type": "paragraph",
        "text": "You can pre-order prior to the pick-up day/time.",
        "spans": [],
        "direction": "ltr"
      },
      {
        "type": "paragraph",
        "text": "Click and Collect",
        "spans": [
          {
