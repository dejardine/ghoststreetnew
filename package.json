{
  "name": "ghoststreet",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck && tsc -p scripts/tsconfig.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "migrate:dry": "tsx scripts/migrate.ts --dry",
    "migrate": "tsx scripts/migrate.ts",
    "verify:assets": "tsx scripts/verify-assets.ts",
    "audit:models": "tsx scripts/audit-models.ts",
    "parity": "tsx scripts/parity.ts",
    "test:interactions": "tsx scripts/interactions.ts"
  },
  "dependencies": {
    "@nuxtjs/prismic": "^5.3.1",
    "@prismicio/client": "^7.22.1",
    "nuxt": "^4.5.2",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@prismicio/migrate": "^0.0.2",
    "@types/node": "^22.20.5",
    "dotenv": "^18.0.5",
    "node-html-parser": "^9.0.4",
    "prismic": "^1.22.0",
    "puppeteer-core": "^25.12.0",
    "sass": "^1.105.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.3.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@parcel/watcher@2.6.0": true
  },
  "engines": {
    "node": ">=22"
  }
}
